# Copy these into Railway → your service → Variables (you do not need a .env file there)
DATA_DIR=/data                  # must match the Volume mount path
PARENT_PASSCODE=choose-a-code   # required to open /parent
ACCESS_CODE=                    # optional family code that locks the whole app
ANTHROPIC_API_KEY=              # optional: switches on live Hooty + "Add a new quest"
COACH_MODEL=claude-haiku-5-5    # optional
GEN_MODEL=claude-sonnet-5-5     # optional
COACH_DAILY_LIMIT=60            # optional cap on Hooty questions per day
